"%1$d mapped values · %2$d exact matches · %3$d intentional/different YSEO "
"values"
msgstr ""
"%1$d valeurs mappées · %2$d correspondances exactes · %3$d valeurs YSEO "
"intentionnellement différentes"

#: src/Analysis/ContentOptimizationAnalyzer.php:262
msgid ""
"%1$d of %2$d H2–H4 headings use the focus keyphrase. Use it where it helps "
"readers and keep headings natural."
msgstr ""
"%1$d sur %2$d titres H2–H4 utilisent la requête cible. Utilisez-la "
"lorsqu’elle aide les lecteurs et gardez des titres naturels."

#: src/Admin/SeoEditorController.php:405
msgid ""
"%1$d of %2$d core product languages currently have complete bundled UI "
"coverage."
msgstr ""
"%1$d langues produit principales sur %2$d disposent actuellement d’une "
"couverture complète de l’interface intégrée."

#: src/Analysis/ContentOptimizationAnalyzer.php:535
msgid ""
"%1$d of %2$d detected custom ARIA interactive roles use checkbox/radio/switch"
" semantics without a valid aria-checked state in saved markup."
msgstr ""
"%1$d rôles interactifs ARIA personnalisés sur %2$d utilisent une sémantique "
"checkbox/radio/switch sans état aria-checked valide dans le balisage "
"enregistré."

#: src/Analysis/ReadabilityAnalyzer.php:128
msgid "%1$d of %2$d detected paragraphs are unusually long for screen reading."
msgstr ""
"%1$d paragraphes détectés sur %2$d sont inhabituellement longs pour une "
"lecture à l’écran."

#: src/Analysis/ContentOptimizationAnalyzer.php:522
msgid ""
"%1$d of %2$d detected saved-content interactive elements lack visible text or"
" a local naming signal in saved markup. Review links, buttons and form fields"
" for visible labels, aria-label/aria-labelledby, associated label elements, "
"title text or other native naming."
msgstr ""
"%1$d éléments interactifs détectés sur %2$d dans le contenu enregistré ne "
"disposent ni de texte visible ni d’un signal de nommage local dans le "
"balisage enregistré. Vérifiez les liens, boutons et champs de formulaire : "
"libellés visibles, aria-label/aria-labelledby, éléments label associés, texte"
" title ou autre nommage natif."

#: src/Analysis/ContentOptimizationAnalyzer.php:331
msgid "%1$d of %2$d images have non-empty alt text."
msgstr "%1$d images sur %2$d ont un texte alternatif non vide."

#: src/Diagnostics/SeoTaskList.php:53
msgid ""
"%1$d of %2$d mandatory product UI locales currently have release-complete "
"evidence."
msgstr ""
"%1$d locales obligatoires de l’interface produit sur %2$d disposent "
"actuellement de preuves complètes pour la publication."

#: src/Analysis/ContentOptimizationAnalyzer.php:295
msgid ""
"%1$d of %2$d related keyphrases appear in current content. Missing from "
"current content: %3$s."
msgstr ""
"%1$d requêtes associées sur %2$d figurent dans le contenu actuel. Absentes du"
" contenu : %3$s."

#: src/Analysis/ContentOptimizationAnalyzer.php:498
msgid ""
