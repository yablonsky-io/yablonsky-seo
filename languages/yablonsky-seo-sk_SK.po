#: src/Analysis/ContentOptimizationAnalyzer.php:215
msgid "The focus keyphrase appears once in the meta description."
msgstr "Hlavná kľúčová fráza sa v metaopise vyskytuje raz."

#: src/Analysis/ContentOptimizationAnalyzer.php:157
#, python-format
msgid "The focus keyphrase contains %d words."
msgstr "Hlavná kľúčová fráza obsahuje %d slov."

#: src/Analysis/ContentOptimizationAnalyzer.php:167
msgid "Rendered SEO title needs the focus keyphrase."
msgstr "Zobrazený názov SEO potrebuje hlavnú kľúčovú frázu."

#: src/Analysis/ContentOptimizationAnalyzer.php:231
