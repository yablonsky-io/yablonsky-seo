msgstr ""
"Yablonsky AI vereist een geschikte facturerings-/gebruiksstatus voor deze "
"compute-request."

#: runtime-hardcode-audit
msgid "Yablonsky AI rejected the request because the payload is too large."
msgstr "Yablonsky AI weigerde de request omdat de payload te groot is."

#: runtime-hardcode-audit
msgid "Yablonsky AI rejected the request contract."
msgstr "Yablonsky AI weigerde het requestcontract."

#: runtime-hardcode-audit
msgid "Yablonsky AI rate limit reached. Wait briefly before retrying."
msgstr "Yablonsky AI-rate limit bereikt. Wacht kort en probeer opnieuw."

#: runtime-hardcode-audit
msgid "Yablonsky AI is temporarily unavailable."
msgstr "Yablonsky AI is tijdelijk niet beschikbaar."

#: runtime-hardcode-audit
msgid "Yablonsky AI request failed with HTTP "
msgstr "Yablonsky AI-request mislukt met HTTP "

