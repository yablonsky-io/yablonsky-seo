msgstr "%1$d no %2$d noteiktajām rindkopām ir neparasti garas lasīšanai ekrānā."

#: src/Analysis/ContentOptimizationAnalyzer.php:522
msgid ""
"%1$d of %2$d detected saved-content interactive elements lack visible text or"
" a local naming signal in saved markup. Review links, buttons and form fields"
" for visible labels, aria-label/aria-labelledby, associated label elements, "
"title text or other native naming."
msgstr ""
"%1$d no %2$d noteiktajiem saglabātā satura interaktīvajiem elementiem "
"saglabātajā marķējumā trūkst redzama teksta vai lokāla nosaukuma signāla. "
"Pārskatiet saites, pogas un veidlapu laukus, lai būtu redzamas etiķetes, "
"aria-label/aria-labelledby, saistīti label elementi, title teksts vai cits "
"vietējais nosaukums."

#: src/Analysis/ContentOptimizationAnalyzer.php:331
msgid "%1$d of %2$d images have non-empty alt text."
msgstr "%1$d no %2$d attēliem ir aizpildīts alt teksts."

