"semantiku potvrdnog okvira/radijskog gumba/prekidača bez valjanog stanja "
"aria-checked u spremljenom označavanju."

#: src/Analysis/ReadabilityAnalyzer.php:128
msgid "%1$d of %2$d detected paragraphs are unusually long for screen reading."
msgstr "%1$d od %2$d otkrivenih odlomaka neuobičajeno je dugo za čitanje na zaslonu."

#: src/Analysis/ContentOptimizationAnalyzer.php:522
msgid ""
"%1$d of %2$d detected saved-content interactive elements lack visible text or"
" a local naming signal in saved markup. Review links, buttons and form fields"
" for visible labels, aria-label/aria-labelledby, associated label elements, "
"title text or other native naming."
msgstr ""
"%1$d od %2$d otkrivenih interaktivnih elemenata spremljenog sadržaja nema "
"vidljiv tekst ni lokalni signal imenovanja u spremljenom označavanju. "
"Pregledajte poveznice, gumbe i polja obrazaca te provjerite vidljive oznake, "
"aria-label/aria-labelledby, povezane elemente label, tekst title ili drugo "
"izvorno imenovanje."

#: src/Analysis/ContentOptimizationAnalyzer.php:331
msgid "%1$d of %2$d images have non-empty alt text."
msgstr "%1$d od %2$d slika ima neprazan alternativni tekst."

#: src/Diagnostics/SeoTaskList.php:53
