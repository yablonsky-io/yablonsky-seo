msgstr "Hlavná kľúčová fráza sa nachádza v adrese URL zdroja."

#: src/Analysis/ContentOptimizationAnalyzer.php:455
msgid "The focus topic is explicit in the first meaningful paragraph."
msgstr "Hlavná téma je jasne uvedená v prvom zmysluplnom odseku."

#: src/Admin/AdminController.php:617
msgid ""
"The key is stored. Verification is pending for account, workspace and model "
