"%1$d yhdistettyä arvoa · %2$d täsmällistä osumaa · %3$d "
"tarkoituksellista/erilaista YSEO-arvoa"

#: src/Analysis/ContentOptimizationAnalyzer.php:262
msgid ""
"%1$d of %2$d H2–H4 headings use the focus keyphrase. Use it where it helps "
"readers and keep headings natural."
msgstr ""
"%1$d/%2$d H2–H4-otsikosta käyttää kohdeavainfraasia. Käytä sitä, kun se "
"auttaa lukijaa, ja pidä otsikot luontevina."

#: src/Admin/SeoEditorController.php:405
msgid ""
"%1$d of %2$d core product languages currently have complete bundled UI "
"coverage."
msgstr ""
"%1$d/%2$d tuotteen ydinkielestä sisältää tällä hetkellä täydellisen mukana "
"toimitetun käyttöliittymäkäännöksen."

#: src/Analysis/ContentOptimizationAnalyzer.php:535
msgid ""
"%1$d of %2$d detected custom ARIA interactive roles use checkbox/radio/switch"
" semantics without a valid aria-checked state in saved markup."
msgstr ""
"%1$d/%2$d havaitusta mukautetusta vuorovaikutteisesta ARIA-roolista käyttää "
"checkbox/radio/switch-semanttiikkaa ilman kelvollista aria-checked-tilaa "
"tallennetussa merkinnässä."

#: src/Analysis/ReadabilityAnalyzer.php:128
msgid "%1$d of %2$d detected paragraphs are unusually long for screen reading."
msgstr ""
"%1$d/%2$d havaitusta kappaleesta on poikkeuksellisen pitkä näytöltä "
"luettavaksi."

#: src/Analysis/ContentOptimizationAnalyzer.php:522
msgid ""
"%1$d of %2$d detected saved-content interactive elements lack visible text or"
" a local naming signal in saved markup. Review links, buttons and form fields"
" for visible labels, aria-label/aria-labelledby, associated label elements, "
"title text or other native naming."
msgstr ""
"%1$d/%2$d havaitusta tallennetun sisällön vuorovaikutteisesta elementistä "
"puuttuu näkyvä teksti tai paikallinen nimeämissignaali tallennetussa "
"merkinnässä. Tarkista linkeistä, painikkeista ja lomakekentistä näkyvät "
"tunnisteet, aria-label/aria-labelledby, niihin liitetyt label-elementit, "
"title-teksti tai muu natiivi nimeäminen."

#: src/Analysis/ContentOptimizationAnalyzer.php:331
msgid "%1$d of %2$d images have non-empty alt text."
msgstr "%1$d/%2$d kuvasta sisältää muun kuin tyhjän alt-tekstin."

#: src/Diagnostics/SeoTaskList.php:53
msgid ""
"%1$d of %2$d mandatory product UI locales currently have release-complete "
"evidence."
msgstr ""
"%1$d/%2$d pakollisesta tuotteen käyttöliittymälokalisaatiosta sisältää tällä "
"hetkellä julkaisukelpoisen näytön."

#: src/Analysis/ContentOptimizationAnalyzer.php:295
msgid ""
"%1$d of %2$d related keyphrases appear in current content. Missing from "
"current content: %3$s."
msgstr ""
"%1$d/%2$d liittyvästä avainfraasista esiintyy nykyisessä sisällössä. "
"Nykyisestä sisällöstä puuttuu: %3$s."

#: src/Analysis/ContentOptimizationAnalyzer.php:498
