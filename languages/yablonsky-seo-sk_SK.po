"title text or other native naming."
msgstr ""
"%1$d z %2$d zistených interaktívnych prvkov uloženého obsahu nemá viditeľný "
"text ani miestny signál pomenovania v uloženom kóde. Skontrolujte odkazy, "
"tlačidlá a polia formulárov: viditeľné popisy, aria-label/aria-labelledby, "
"priradené štítky, titulky alebo iné natívne pomenovanie."

#: src/Analysis/ContentOptimizationAnalyzer.php:331
msgid "%1$d of %2$d images have non-empty alt text."
msgstr "%1$d z %2$d obrázkov má vyplnený alternatívny text."

#: src/Diagnostics/SeoTaskList.php:53
