msgstr ""
"YSEO potrzebuje kompletnego tekstu na poziomie zdań, zanim oceni strukturę "
"zdań."

#: src/Analysis/ReadabilityAnalyzer.php:93
msgid ""
"YSEO needs sentence punctuation before it can evaluate compact-script "
"sentence structure."
msgstr ""
"YSEO potrzebuje interpunkcji zdań, zanim oceni strukturę zdań w pismach "
"kompaktowych."

#: src/Visibility/ReadinessAudit.php:83
msgid ""
